# Copy to .env.local for development. Server-side only: never exposed to the browser.

# Where the ASP.NET API lives. REQUIRED in production.
API_BASE_URL=http://localhost:5073

# Optional. Session cookies are "Secure" (HTTPS only) in production builds.
# Set to false ONLY to test a production build over plain http on another machine.
# COOKIE_SECURE=false
